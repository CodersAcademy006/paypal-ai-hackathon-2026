# PayPal sandbox app — developer.paypal.com → Dashboard → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# No key needed: AI runs locally via Ollama (brew services start ollama; ollama pull llama3.2:3b)
# Override only if you're running a different local model or host.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

PORT=3000
